# WorkOS AuthKit Next.js App - Local Development Configuration
# Copy to .env.local and fill in real values: cp env.example .env.local

# Get these from https://dashboard.workos.com -> API Keys
WORKOS_API_KEY=sk_test_your-api-key
WORKOS_CLIENT_ID=client_your-client-id

# Cookie encryption password (must be 32+ characters)
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=your-cookie-password-at-least-32-chars

# Redirect URI (must match WorkOS dashboard config)
WORKOS_REDIRECT_URI=http://localhost:3000/callback
