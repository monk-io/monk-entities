# GCP Cloud Tasks Demo - Local Development Configuration
# Copy to .env and fill in real values: cp env.example .env

# These are automatically provided by MonkEC when using the full stack.
# Only needed for local development/testing outside monk.

# Full queue resource name (from entity state)
QUEUE_NAME=projects/my-project/locations/us-central1/queues/my-queue

# GCP project ID
GCP_PROJECT=my-project

# Queue location
QUEUE_LOCATION=us-central1

# HTTP target for tasks (default: httpbin.org)
TARGET_URL=https://httpbin.org/post

# Service account credentials JSON (optional if using ADC)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Client configuration
OPERATION_INTERVAL_MS=5000
MAX_OPERATIONS=10
