# multi-cloud-demo — Local Development Configuration
# Copy to .env and fill in real values: cp env.example .env
# These are automatically wired by MonkEC when deploying via monk run.

# App mode: api | worker | both
MODE=both
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskdb
DB_USER=postgres
DB_PASSWORD=

# Queue type: sqs | servicebus | db
QUEUE_TYPE=db

# AWS SQS (if QUEUE_TYPE=sqs)
SQS_QUEUE_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Service Bus (if QUEUE_TYPE=servicebus)
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=tasks

# DB polling interval in ms (if QUEUE_TYPE=db)
DB_POLL_INTERVAL_MS=2000

# Storage type: s3 | azure-blob | spaces
STORAGE_TYPE=s3

# AWS S3 / DigitalOcean Spaces
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=          # leave empty for S3; set to e.g. nyc3.digitaloceanspaces.com for Spaces
STORAGE_ACCESS_KEY=        # falls back to AWS_ACCESS_KEY_ID if empty
STORAGE_SECRET_KEY=        # falls back to AWS_SECRET_ACCESS_KEY if empty

# Azure Blob (if STORAGE_TYPE=azure-blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=task-results
