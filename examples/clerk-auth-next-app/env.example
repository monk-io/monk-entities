# Clerk Auth Next.js App - Local Development Configuration
# Copy to .env.local and fill in real values: cp env.example .env.local

# Get these from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/protected
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/protected
