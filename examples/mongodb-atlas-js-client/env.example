# mongodb-atlas-js-client - Local Development Configuration
# Copy to .env and fill in real values: cp env.example .env
#
# When deployed via the Monk stack, these are wired automatically from the
# project/cluster/user entity state + secrets. Only needed for local dev.

# Either provide a full pre-authenticated URI:
# MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ...or provide the SRV string + credentials separately (the app builds the URI):
MONGODB_CONNECTION_STRING=mongodb+srv://cluster.xxxxx.mongodb.net
MONGODB_USERNAME=app-user
MONGODB_PASSWORD=your-password-here

# Target database / collection (optional)
MONGODB_DATABASE=monkdemo
MONGODB_COLLECTION=events

# Client behavior (optional)
OPERATION_INTERVAL_MS=5000
MAX_OPERATIONS=0
