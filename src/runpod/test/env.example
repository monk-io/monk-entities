# RunPod API key — create one in the RunPod console under Settings → API Keys.
# RunPod does not offer scoped keys; this grants full account access.
RUNPOD_API_TOKEN=your-runpod-api-key-here

# Optional test runner configuration
MONKEC_VERBOSE=true

# ---------------------------------------------------------------------------
# Cost warning
#
# This suite provisions a real CPU pod and a real 10 GB network volume, both of
# which bill against the account. A full run takes minutes and costs cents, but
# a failed teardown leaves a pod billing hourly until it is removed.
#
# After an aborted run, verify nothing is left behind:
#   curl -H "Authorization: Bearer $RUNPOD_API_TOKEN" https://api.runpod.io/v2/pods
#   curl -H "Authorization: Bearer $RUNPOD_API_TOKEN" https://api.runpod.io/v2/network-volumes
# ---------------------------------------------------------------------------
