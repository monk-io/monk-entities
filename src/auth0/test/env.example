# Auth0 tenant domain, e.g. your-tenant.us.auth0.com
# NOTE: this value is NOT auto-injected into test/stack-template.yaml (only secrets
# get $VAR expansion there) — also replace the `domain:` fields in that file by hand
# to match.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Machine-to-Machine application credentials, authorized for the Auth0 Management
# API with the scopes listed in README.md
AUTH0_MANAGEMENT_CLIENT_ID=your-m2m-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-m2m-client-secret
